# SEC requires a real name + email in the User-Agent. Requests without it get blocked.
SEC_USER_AGENT="Your Name your.email@example.com"

# LLM backend: ollama | groq | gemini (all spoken to via the OpenAI-compatible API)
LLM_PROVIDER=ollama
LLM_MODEL_EXTRACT=qwen2.5:7b
LLM_MODEL_EXPLAIN=llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434/v1
GROQ_API_KEY=
GEMINI_API_KEY=
# Start the Ollama server with OLLAMA_KEEP_ALIVE=1h so the model stays warm.

# Paths
DATA_DIR=./data
AUDIT_DB_PATH=./data/audit.db
CHECKPOINT_DB_PATH=./data/checkpoints.db

# Thresholds (defaults; adjustable live from the dashboard)
CONFIDENCE_THRESHOLD=0.85
YOY_THRESHOLD_PCT=40
ACCOUNTING_TOLERANCE_PCT=0.1
SEGMENT_TOLERANCE_PCT=0.1
ACCURACY_TOLERANCE_PCT=0.01

# Development switches: let each person work before teammates finish
USE_FAKES=false          # Person 2: use workflow/fakes.py instead of real extraction/verification
USE_MOCK_SERVICE=false   # Person 3: API serves api/mock_service.py instead of the real workflow

# API
API_HOST=127.0.0.1
API_PORT=8000
