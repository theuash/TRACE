# Copy to .env and edit. .env is gitignored - never commit real keys.

# SEC EDGAR contact. SEC rejects requests without a real one.
SEC_USER_AGENT=Your Name your.email@example.com

# LLM (all providers go through llm/client.py, OpenAI-compatible)
LLM_PROVIDER=ollama
LLM_MODEL_EXTRACT=qwen2.5-coder:1.5b
LLM_MODEL_EXPLAIN=qwen2.5-coder:1.5b
LLM_TIMEOUT_S=60
# GROQ_API_KEY=
# GEMINI_API_KEY=

# Development switches. false = real implementations.
USE_FAKES=false
USE_MOCK_SERVICE=true

# API
API_HOST=127.0.0.1
API_PORT=8000
