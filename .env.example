# Copy to .env and edit. .env is gitignored - never commit real keys.

# SEC EDGAR contact. SEC rejects requests without a real one.
SEC_USER_AGENT=Your Name your.email@example.com

# LLM (all providers go through llm/client.py, OpenAI-compatible)
LLM_PROVIDER=ollama
LLM_MODEL_EXTRACT=qwen2.5-coder:1.5b
LLM_MODEL_EXPLAIN=qwen2.5-coder:1.5b
LLM_TIMEOUT_S=60
# GROQ_API_KEY=
# GEMINI_API_KEY=

# Development switches. false = real implementations.
USE_FAKES=false

# Database (Neon PostgreSQL). Both URLs come from the Neon console:
#   Connection Details -> "Pooled connection" -> NEON_POOL_URL
#   Connection Details -> "Direct connection"  -> NEON_DIRECT_URL
# The app prefers the direct URL (the pooler adds ~1s per query); the pooled URL is the
# fallback and the right choice for a serverless deployment.
# NEON_POOL_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# NEON_DIRECT_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# API
API_HOST=127.0.0.1
API_PORT=8000
